# ---- 本地工具链（仅开发机，不入库）----
.toolchain/
.toolchain_setup.py
.toolchain_setup.ps1

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# ---- Nuitka / 构建产物 ----
nuitka-crash-report.xml
*.build/
*.dist/
*.onefile-build/
dist/
build/out/
*.build/
*.dist/
*.onefile-build/
*.exe

# ---- 验收用真实模组样本（体积大，不入库；用 docs/research 下的脚本重新拉取）----
mods_sample/
.demo_mods/

# ---- 运行时生成的本地配置与缓存（便携模式）----
config/
!docs/**
*.log

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini

# ---- 现场生成的演示环境（tests/make_fixtures.py，二进制不入库）----
tests/_fixtures/
# ---- 打包产物（由 build/nuitka_build.py 生成，不入库）----
# 二进制产物应随 Release 分发，而不是进版本库：
# 它们体积大、每次构建都变，留在库里只会让 git status 全是噪音。
dist/
dist-standalone/
dist-gui/

# ---- 测试/脚本的临时产物 ----
testresult/

# publish/ 里的文档是**生成的副本**（源在根目录与 docs/），内容需要进库；
# 只有它打出来的源码 zip 是产物，不入库。
publish/*.zip